# Public WhatsApp contact is configured in src/lib/contact.ts.
BACKEND_INTERNAL_URL=http://transporte-seguro-api:3001
# Local dev default: http://127.0.0.1:3001. Pass overrides when starting Vite:
# BACKEND_DEV_URL=http://127.0.0.1:3001 npm run dev

# Backend (configured on the API service in Coolify)
DATABASE_URL=postgres://transporte_seguro:change-me@transporte-seguro-db:5432/transporte_seguro
EXPECTED_DATABASE_NAME=transporte_seguro
PROJECT_KEY=transporte-seguro
SESSION_SECRET=replace-with-a-long-random-value
FILE_ROOT=/data
WEB_ORIGIN=https://transporte-seguro.example.com
APIPLACAS_TOKEN=configure-in-coolify-api-only
